{
  "name": "termward",
  "productName": "Termward",
  "version": "0.1.0",
  "description": "SSH manager for many servers with proactive health alerts and SSH key management.",
  "author": "nguyenquocanhz",
  "license": "MIT",
  "homepage": "https://github.com/nguyenquocanhz/termward",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "core": "node scripts/build-core.mjs",
    "icons": "node scripts/make-icons.mjs",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "tsc -p tsconfig.json --noEmit && vite build",
    "build": "npm run core && npm run build:electron && npm run build:renderer",
    "dev": "npm run core && npm run build:electron && node scripts/dev.mjs",
    "dev:web": "vite",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "dist": "npm run build && electron-builder",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\" \"scripts/**/*.{mjs,cjs}\"",
    "mobile:core:android": "node scripts/mobile.mjs core android",
    "mobile:core:ios": "node scripts/mobile.mjs core ios",
    "mobile:web": "node scripts/mobile.mjs web"
  },
  "build": {
    "appId": "io.github.nguyenquocanhz.termward",
    "productName": "Termward",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "assets/**",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../core/bin",
        "to": "core",
        "filter": [
          "termwardd",
          "termwardd.exe"
        ]
      }
    ],
    "icon": "assets/icon.png",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "nguyenquocanhz <https://github.com/nguyenquocanhz>"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/status-bar": "^8.0.3",
    "termward-ios-core": "file:native/ios-core"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.47.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "zustand": "^5.0.15"
  }
}
